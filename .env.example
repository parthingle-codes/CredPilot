# Copy to .env for local backend development. Never commit .env.
# For Render, set HF_TOKEN in the dashboard (render.yaml marks it sync: false).

# --- Backend ---
# Optional. Without it, deterministic checks still run; Gemma explanations are disabled.
HF_TOKEN=
# Gemma model routed through Hugging Face Inference Providers.
GEMMA_MODEL=google/gemma-4-26B-A4B-it:cheapest
# Comma-separated browser origins allowed to call the API in local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Small in-process guard for the optional AI endpoint.
AI_REQUESTS_PER_MINUTE=10
AI_TIMEOUT_SECONDS=45

# --- Frontend (optional) ---
# Leave blank to use same-origin /api (Vite proxies to localhost:8000 in dev).
# Set only if you split the frontend and backend onto different hosts.
VITE_API_URL=

# --- Production static serving (Docker sets this automatically) ---
# CREDPILOT_STATIC_DIR=/app/static
